---
import '../../app.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{entry.data.title} - Nathan Zumbusch</title>
    <meta name="description" content={entry.data.excerpt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
</head>
<body class="bg-light text-zinc-900 font-rubik min-h-screen flex flex-col selection:bg-emerald-500/30">
    <nav class="fixed top-0 w-full bg-white/80 backdrop-blur-md border-b border-zinc-200 z-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 py-4 flex justify-between items-center">
            <a href="/" class="text-zinc-900 font-playfair font-bold text-xl hover:text-emerald-600 transition-colors">NZ.</a>
            <div class="flex gap-4 sm:gap-6 text-xs sm:text-sm uppercase tracking-wider font-medium text-zinc-500">
                <a href="/blog" class="hover:text-emerald-600 transition-colors">Back to Blog</a>
            </div>
        </div>
    </nav>

    <main class="max-w-3xl mx-auto px-6 pt-32 pb-24 w-full flex-grow">
        <header class="mb-12 border-b border-zinc-200 pb-8 text-center">
            <span class="px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold uppercase tracking-widest rounded-full mb-4 inline-block">{entry.data.category}</span>
            <h1 class="text-3xl md:text-5xl font-playfair font-bold text-zinc-900 mb-6">{entry.data.title}</h1>
            <time class="text-zinc-500 font-mono">{entry.data.date.toISOString().split('T')[0]}</time>
        </header>

        <article class="prose prose-zinc prose-lg mx-auto prose-headings:font-playfair prose-a:text-emerald-600 hover:prose-a:text-emerald-500">
            <Content />
        </article>
    </main>

    <footer class="border-t border-zinc-200 py-12 text-center text-zinc-500 text-sm px-6 w-full">
        <p>&copy; {new Date().getFullYear()} Nathan Zumbusch. All Rights Reserved.</p>
        <p class="mt-2 text-xs opacity-75 max-w-2xl mx-auto">Scraping or utilizing this content for the purpose of training artificial intelligence models (LLMs) is strictly prohibited without explicit written permission.</p>
    </footer>
</body>
</html>
